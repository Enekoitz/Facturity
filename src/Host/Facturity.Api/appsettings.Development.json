{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "ConnectionStrings": {
    "FacturityDbConnectionString": "Host=localhost;Port=5432;Database=facturity;Username=postgres;Password='rootroot'"
  },

  "Jwt": {
    "Issuer": "Facturity",
    "Audience": "FacturityClient",
    "SigningKey": "K7xP2mN9qR4vL8sT1wZ6yB3jH5fD0gC2eA9uY7iX4oQ8nM1kW5rV3tS6zJ0hL2bF",
    "ExpirationMinutes": 15
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq", "Serilog.Enrichers.Environment" ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FacturityAPI"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",

        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "restrictedToMinimumLevel": "Debug",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{Application}/{MachineName}] [CorrelationId: {CorrelationId}] {Message:lj}{NewLine}{Exception}"
              }
            },

            {
              "Name": "File",
              "Args": {
                "restrictedToMinimumLevel": "Information",
                "path": "Logs/Facturity-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "fileSizeLimitBytes": 10485760,
                "rollOnFileSizeLimit": true,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{Application}/{MachineName}] [CorrelationId: {CorrelationId}] [{SourceContext}] {Message:lj} {NewLine}{Exception}"
              }
            },

            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://localhost:5341",
                "apiKey": "acrlXxVJ0HRBVgO2H0d5"
              }
            }
          ]
        }
      }
    ]
  }
}
